# .editorconfig — editor formatting rules for this project.
# VS Code obeys this via the EditorConfig extension.
# Rules here override any conflicting workspace or user settings.
root = true

[*]
indent_style  = space
indent_size   = 4
end_of_line   = lf
charset       = utf-8
trim_trailing_whitespace = true
insert_final_newline     = true

[*.md]
# Markdown allows trailing spaces (they mean a line break),
# so we turn off trimming for those files only.
trim_trailing_whitespace = false
