# SAM build output — generated every time you run sam build, never commit it
.aws-sam/
.claude/
# Python bytecode — compiled cache files Python generates automatically
__pycache__/
*.py[cod]

# Virtual environments — local dependency installs, not part of the repo
.venv/
venv/

# Secrets and environment config — never commit credentials
.env
.env.*
# personal deployment scripts — not relevant to teammates
dev-deploy.sh
dev-post-deploy.sh
dev-prep.sh

# IDE files — personal editor settings, irrelevant to teammates
.vscode/
.idea/

# OS noise
.DS_Store
Thumbs.db

# Test coverage reports — generated output, not source
.coverage
htmlcov/
.pytest_cache/
