# .gitattributes — Git line-ending normalization.
# 'text=auto eol=lf' means: Git detects text files automatically
# and rewrites them to LF on commit. Your working copy on Windows
# may still show CRLF in some tools, but the repo always stores LF.

*           text=auto eol=lf

# Binary files — never touch line endings in these.
*.png       binary
*.jpg       binary
*.zip       binary
*.whl       binary
